# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-transcribe"

# OPENAI_API_KEY: Required for OpenAI ChatGPT API calls.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Primary AI provider (gemini or openai)
AI_PRIMARY_PROVIDER="gemini"

# Retry Policy Settings
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000

# Circuit Breaker Settings
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000

# PORT & Network Settings
PORT=3000

# VITE_API_URL: Public URL of the remote API backend (used in Android Capacitor production build)
VITE_API_URL="https://ais-pre-xzlo5557dhnd2jwtdxkun6-567533425465.europe-west2.run.app"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ais-pre-xzlo5557dhnd2jwtdxkun6-567533425465.europe-west2.run.app"
